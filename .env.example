# Database — local Postgres for dev, Neon pooled connection string for prod
DATABASE_URL="postgresql://localhost:5432/disclosure_ledger"

# Anthropic Claude — parser adjudication, mention extraction, caption speaker-segmentation
ANTHROPIC_API_KEY=""

# api.data.gov key — shared across govinfo + regulations.gov
DATA_GOV_API_KEY=""

# Price enrichment (free tiers)
ALPHAVANTAGE_API_KEY=""
FINNHUB_API_KEY=""

# Caption retrieval (free tier) — existing-caption fetch, no ASR
SUPADATA_API_KEY=""

# YouTube Data API — video discovery only
YOUTUBE_API_KEY=""

# Crawler identity (required by SEC EDGAR + politeness everywhere)
CRAWLER_USER_AGENT="trump-stock-tracker civic-transparency project (contact: benjamin@opencivics.co)"

# Public site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Read-only role for the serving tier (falls back to DATABASE_URL)
DATABASE_URL_RO=""

# On-demand ISR refresh — the pipeline calls /api/revalidate?secret=…
REVALIDATE_SECRET=""

# Operator review queue (/admin/review) — disabled unless set
ADMIN_USER="admin"
ADMIN_PASSWORD=""

# Cross-source reconciliation snapshot (NDJSON) — local path or URL
RECONCILE_DATA_PATH=""
RECONCILE_DATA_URL=""
